# FOREXAA environment variables
#
# Policy:
# - ONLY variable NAMES and safe default hints live in source control (this file).
# - Real values are placed in .env.local (gitignored). Never commit .env.local.
# - Anything that can never be shipped to the client is read exclusively in
#   server code via src/lib/env.ts.

# --- Application -------------------------------------------------------------
# Development | production | test
NODE_ENV=development

# Base URL the site is served from. Used for canonical/OG metadata.
# Local dev default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Security ----------------------------------------------------------------
# Comma-separated list of extra origins to allow into the production
# Content-Security-Policy (img-src/connect-src). Keep empty unless a
# third-party integration is explicitly approved in
# docs/security/SECURITY-BASELINE.md.
CSP_ALLOWED_ORIGINS=

# --- Logging -----------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Third-party integrations (later phases only; add entries as needed) -----
# Examples (do NOT fill in real secrets here):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# RECAPTCHA_SECRET=
