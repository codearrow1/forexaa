import { getRoute, buildPageSeo } from "@/lib/seo/page-meta";
import { JsonLdGraph } from "@/components/shared/json-ld";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Section } from "@/components/ui/section";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { ContactForm } from "@/components/product/contact-form";
import { ScrollScene } from "@/components/story/primitives";
import { sanitizeIntent, intentToInterest } from "@/lib/contact-intent";

const route = getRoute("/contact");
const seo = buildPageSeo(route);
export const metadata = seo.metadata;

const INTENT_LABELS: Record<string, string> = {
  demo: "Book a Demo",
  crm: "Explore the CRM",
  platform: "Platform Inquiry",
  liquidity: "Liquidity Architecture",
  "white-label": "White-Label Launch",
  prop: "Prop Firm Solution",
  "existing-broker": "Migration / Integration",
  pricing: "Request Pricing",
  general: "General Question",
};

const INTENT_VISUALS: Record<string, { title: string; detail: string }> = {
  demo: { title: "See the platform in action", detail: "A guided demo tailored to your brokerage model." },
  crm: { title: "Explore the CRM", detail: "Client lifecycle, partners, finance and reporting in one system." },
  platform: { title: "Platform inquiry", detail: "MT4, MT5, MT7 or cTrader — connected to your operation." },
  liquidity: { title: "Liquidity architecture", detail: "Aggregation, pricing and routing for your execution." },
  "white-label": { title: "White-label launch", detail: "Your brand, on connected brokerage technology." },
  prop: { title: "Prop firm solution", detail: "Challenges, risk rules and funding workflows." },
  "existing-broker": { title: "Migration / integration", detail: "Connect or replace components of your current stack." },
  pricing: { title: "Request pricing", detail: "A quote matched to your deployment scope — not a generic number." },
  general: { title: "General question", detail: "Tell us what you need and we will route it." },
};

/**
 * /contact — commercial conversion page (Rule 47/48).
 *
 * Context-aware: ?intent= preselects the form intent and updates the visual.
 * The query is validated against a strict enum — never reflected into HTML,
 * metadata, redirects, logs or email templates (Rule 15).
 */
export default function ContactPage({
  searchParams,
}: {
  searchParams: Promise<{ intent?: string }>;
}) {
  return (
    <ContactPageContent searchParams={searchParams} />
  );
}

async function ContactPageContent({
  searchParams,
}: {
  searchParams: Promise<{ intent?: string }>;
}) {
  const { intent: rawIntent } = await searchParams;
  const intent = sanitizeIntent(rawIntent);
  const interest = intentToInterest(intent);
  const visual = INTENT_VISUALS[intent];

  return (
    <>
      <JsonLdGraph nodes={seo.jsonLd} />
      <Section spacing="default" className="!pt-10">
        <div className="flex flex-col gap-10">
          <div className="flex flex-col gap-6">
            <Breadcrumbs current="/contact" />
            <div className="grid gap-10 lg:grid-cols-2 lg:items-start">
              {/* Left: context-aware visual + copy */}
              <div className="flex flex-col gap-4">
                <Badge tone="primary">Contact</Badge>
                <h1 className="type-product-hero">Talk to the FOREXAA team</h1>
                <p className="type-lead text-text-muted">
                  Tell us what you are building — a new brokerage, a
                  migration, a prop firm, a multi-asset operation — and we
                  will respond to scope a demo or a quote.
                </p>

                {/* Context-aware visual (Rule 78) */}
                <Card variant="glass" className="mt-2 p-5">
                  <div className="flex items-center gap-3">
                    <span className="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/15 type-body font-semibold text-primary">
                      {(INTENT_LABELS[intent] ?? "General").charAt(0)}
                    </span>
                    <div>
                      <div className="type-body font-semibold text-text">
                        {visual?.title ?? "General Question"}
                      </div>
                      <div className="type-caption text-text-muted">
                        {visual?.detail ?? "Tell us what you need and we will route it."}
                      </div>
                    </div>
                  </div>
                </Card>

                <div className="flex flex-col gap-2.5">
                  <div className="type-small text-text-muted">
                    We respond to scoped, genuine brokerage conversations.
                  </div>
                  <div className="type-small text-text-muted">
                    No passwords, payment details, identity documents or API
                    keys are requested or accepted here.
                  </div>
                </div>
              </div>

              {/* Right: form with preselected intent */}
              <Card variant="glass" className="p-6">
                <ContactForm preselectedInterest={interest} intent={intent} />
              </Card>
              
              </Card>
            </div>
          </div>

          {/* What happens next — sets expectations without fake urgency */}
          <ScrollScene>
          <div className="grid gap-3 md:grid-cols-3">
            <Card variant="elevated" className="flex flex-col gap-2 p-5">
              <span className="type-label text-text-muted">1 · Scope</span>
              <p className="type-small text-text-muted">
                We confirm your platform choice, structure and compliance
                context.
              </p>
            </Card>
            <Card variant="elevated" className="flex flex-col gap-2 p-5">
              <span className="type-label text-text-muted">2 · Plan</span>
              <p className="type-small text-text-muted">
                You get a deployment plan and pricing matched to that scope —
                not a generic number.
              </p>
            </Card>
            <Card variant="elevated" className="flex flex-col gap-2 p-5">
              <span className="type-label text-text-muted">3 · Build</span>
              <p className="type-small text-text-muted">
                Configuration, integration and migration, with support
                through go-live.
              </p>
            </Card>
          </div>
          </ScrollScene>
        </div>
      </Section>
    </>
  );
}

